{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Typing Trainer",
  "version": "1.0.0",
  "identifier": "org.typingtrainer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Typing Trainer",
        "width": 1200,
        "height": 840,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Free, open-source cross-platform touch typing tutor",
    "longDescription": "Typing Trainer is a modern, privacy-respecting, multi-platform touch typing trainer featuring structured curriculums, multi-user profiles with PIN lock, dynamic SVG keyboard, and arcade games."
  }
}
